# Sample hostapd config — turns the CYRAD server into the WiFi AP itself.
# Only needed if you don't have a separate hardware AP. The AP forwards 802.1X
# auth to the local FreeRADIUS server (no captive portal).
#
# Generated by install.sh --ap; shown here as a reference.

interface=wlan0
driver=nl80211
ssid=CYRAD-Students
hw_mode=g
channel=6
macaddr_acl=0
auth_algs=1
ignore_broadcast_ssid=0

# 802.1X / WPA2-Enterprise
wpa=2
wpa_key_mgmt=WPA-EAP
wpa_pairwise=TKIP CCMP
ieee8021x=1
eap_server=0

# Forward auth/acct to local FreeRADIUS
own_ip_addr=127.0.0.1
auth_server_addr=127.0.0.1
auth_server_port=1812
auth_server_shared_secret=cyradsecret
acct_server_addr=127.0.0.1
acct_server_port=1813
acct_server_shared_secret=cyradsecret
