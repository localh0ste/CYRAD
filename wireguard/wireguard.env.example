# Template only — no real secrets. Copy to /etc/cyrad/wireguard.env (chmod 600)
# if you want a reusable shell source. NEVER put this file inside the web root.
# The VPS installer generates the real values in /root/cyrad-wireguard-router.env
# and a ready-to-run /root/cyrad-router-bootstrap.sh.

# Backend / VPS
SERVER_ENDPOINT=203.0.113.10        # public IP of the CYRAD VPS
WG_PORT=51820                       # UDP port WireGuard listens on
SERVER_WG_IP=10.9.0.1                # VPS tunnel IP
ROUTER_WG_IP=10.9.0.2                # router tunnel IP (also CYRAD_DAS_TARGET_IP)
CYRAD_HTTP_PORT=8000                 # persistent bootstrap HTTP service port

# Keys (generated by server/setup-wireguard-server.sh if left empty)
SERVER_PRIVATE_KEY=
SERVER_PUBLIC_KEY=
ROUTER_PRIVATE_KEY=
ROUTER_PUBLIC_KEY=

# Router APIs
RADIUS_SECRET=replace-with-radius-secret
API_TOKEN=replace-with-api-token
ORG_ID=0                             # 0 = all enabled DNS block rules
CYRAD_VPS_SSH_PUBKEY=                # VPS public key for passwordless kick helper

# VPS side
ROUTER_SSH_HOST=10.9.0.2
CYRAD_KICK_BIN=/usr/local/bin/cyrad_router_kick
